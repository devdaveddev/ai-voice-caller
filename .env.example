# --- Public URL of this server (ngrok https URL, no trailing slash) ---
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# --- Tuning (optional) ---
SILENCE_TIMEOUT_S=5
ENDPOINT_SILENCE_MS=700
VALIDATE_TWILIO_SIGNATURE=true
